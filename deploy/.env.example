# Docker Compose project name (prefix for containers/volumes)
COMPOSE_PROJECT_NAME=turbo-base

TZ=Asia/Ho_Chi_Minh

# Restart policy for all services
#   dev:  no              (only start on `pnpm infra:up`)
#   prod: unless-stopped  (auto start after reboot/crash, unless stopped manually)
RESTART_POLICY=no

# PostgreSQL
POSTGRES_VERSION=18-alpine
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me


# Redis (shared by api + socket)
REDIS_VERSION=8-alpine
REDIS_BIND=127.0.0.1
REDIS_PORT=6379

# File storage (S3 / MinIO, btp format) for the api container – real values
# only in deploy/.env (untracked)
STORAGE_CORE_S3_SERVERS='[{"NAME":"default","CONFIG":{"PUBLIC_ENDPOINT":"https://minio.example.com","ENDPOINT":"https://minio.example.com","KEY":"<access-key>","SECRET":"<secret-key>","REGION":"us-east-1"}}]'
STORAGE_BUCKET=<bucket>

# Auth (api + socket): openssl rand -base64 48
JWT_SECRET=<at-least-32-characters>
# open | closed (accounts from seed / admins)
AUTH_REGISTRATION=closed
# Parent domain when web and api are on different subdomains, e.g. example.com
COOKIE_DOMAIN=
# Sign-in with providers: they redirect to <PUBLIC_API_URL>/auth/oauth/<provider>/callback, then the
# browser lands on WEB_ORIGIN (both below). A provider is on when both its id and secret are set – real values only in deploy/.env
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Apps (profile "app": `pnpm stack:up`)
# Deployment environment: dev | stg | prod (docs/process/environments.md)
APP_ENV=dev
APP_BIND=127.0.0.1
API_PORT=3001
SOCKET_PORT=3002
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
# Public URLs the browser uses (baked into the web image at build time).
# APP_ENV stg/prod: must be the deployed URLs – the web build rejects localhost.
PUBLIC_API_URL=http://localhost:3001/api
PUBLIC_SOCKET_URL=http://localhost:3002
