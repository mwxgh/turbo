generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Plain interfaces + enums for the web, committed in packages/types
generator types {
  provider = "tsx prisma/generators/types.ts"
  output   = "../../types/src/generated"
}

datasource db {
  provider = "postgresql"
}

model Hello {
  id        String   @id @default(uuid(7)) @db.Uuid
  message   String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Default list order: `createdAt desc, id desc`
  @@index([createdAt, id])
  @@map("hellos")
}

/// What a user may do: ADMIN manages the app, USER is everyone else
enum Role {
  USER
  ADMIN
}

/// Someone who signs in: with a password and / or external providers (`UserIdentity`);
/// `passwordHash` stays null for accounts that only use a provider.
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Lowercase. Sign in with email or username
  email        String?   @unique @db.VarChar(255)
  /// Lowercase
  username     String?   @unique @db.VarChar(50)
  name         String?   @db.VarChar(100)
  /// @private argon2id hash, PHC format (`@repo/nest-common/auth`); null when the account has no password
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  role         Role      @default(USER)
  /// Set to block sign-in and refresh; existing access tokens expire on their own
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions   Session[]
  identities UserIdentity[]

  lingoBatches    LingoBatch[]
  lingoAttempts   LingoAttempt[]
  lingoGoals      LingoGoal[]
  lingoDecks      LingoDeck[]
  lingoCardStates LingoCardState[]
  lingoChats      LingoChat[]
  lingoTests      LingoTest[]

  plannerTasks PlannerTask[]

  studioProgress StudioProgress[]

  @@map("users")
}

/// Sign-in providers (OAuth 2.0 authorization code + PKCE, handled by the api).
enum OAuthProvider {
  GOOGLE
  FACEBOOK
  GITHUB
}

/// @private A provider account that signs in as a user. `subject` is the provider's stable user id
/// (never the email: emails change and can be reassigned).
model UserIdentity {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  OAuthProvider
  subject   String        @db.VarChar(255)
  /// Email the provider reported at the last sign-in (informational; lowercase)
  email     String?       @db.VarChar(255)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

/// @private One signed-in device. The refresh token is `<id>.<secret>`; only hashes are stored and the
/// secret rotates on every refresh (the previous one stays valid for a short grace period).
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 (hex) of the current refresh secret
  tokenHash     String    @map("token_hash") @db.Char(64)
  /// sha256 of the secret before the last rotation (concurrent refreshes from tabs)
  prevTokenHash String?   @map("prev_token_hash") @db.Char(64)
  rotatedAt     DateTime? @map("rotated_at") @db.Timestamptz(3)
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  ip            String?   @db.VarChar(45)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

// ─── Lingo: language learning and exam prep (docs/product/lingo.md) ───────────────────────────
// Exam / section / part codes are strings defined in apps/api/src/lingo/specs (not enums), so a
// new exam needs no migration.

/// Review state of learning content: only PUBLISHED reaches learners
enum LingoContentStatus {
  DRAFT
  NEEDS_REVIEW
  PUBLISHED
  REJECTED
}

enum LingoDifficulty {
  EASY
  MEDIUM
  HARD
}

/// Where a batch of content came from
enum LingoBatchSource {
  MANUAL
  IMPORT
  AI
}

/// RUNNING: an AI run still generating in the background
enum LingoBatchStatus {
  RUNNING
  DONE
  FAILED
}

/// FULL: every part at full length; MINI: every part, about half the questions
enum LingoTestKind {
  FULL
  MINI
}

/// QUICK: a few questions of one part; PRACTICE: chosen parts of a test; FULL_TEST: scaled score
enum LingoAttemptMode {
  QUICK
  PRACTICE
  FULL_TEST
  /// Placement test: a few questions of every part, estimated score picks the roadmap stage
  PLACEMENT
}

/// One import / manual entry / AI run: what came in and what was rejected
model LingoBatch {
  id          String           @id @default(uuid(7)) @db.Uuid
  source      LingoBatchSource
  exam        String           @db.VarChar(32)
  part        String?          @db.VarChar(16)
  fileName    String?          @map("file_name") @db.VarChar(255)
  succeeded   Int              @default(0)
  failed      Int              @default(0)
  /// `[{ line, issues: string[] }]` for rows that failed validation
  errors      Json?
  status      LingoBatchStatus @default(DONE)
  /// What an AI run was asked for (`{ difficulty, topic, count, kind }`)
  request     Json?
  /// Why a RUNNING batch FAILED
  message     String?          @db.VarChar(1000)
  createdById String           @map("created_by_id") @db.Uuid
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  items LingoItem[]
  tests LingoTest[]

  @@index([createdAt, id])
  @@map("lingo_batches")
}

/// One stimulus (sentence, passage, recording, picture) with its questions
model LingoItem {
  id          String             @id @default(uuid(7)) @db.Uuid
  exam        String             @db.VarChar(32)
  section     String             @db.VarChar(16)
  part        String             @db.VarChar(16)
  difficulty  LingoDifficulty
  topic       String?            @db.VarChar(100)
  /// Stimulus as JSON (`{ passage?, transcript? }`), shape set by the part spec
  content     Json               @default("{}")
  audioKey    String?            @map("audio_key") @db.VarChar(255)
  imageKey    String?            @map("image_key") @db.VarChar(255)
  status      LingoContentStatus @default(DRAFT)
  batchId     String?            @map("batch_id") @db.Uuid
  batch       LingoBatch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  /// sha256 of the canonical item: the same item is never imported twice
  contentHash String             @map("content_hash") @db.Char(64)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  questions LingoQuestion[]
  tests     LingoTestItem[]

  @@unique([exam, contentHash])
  @@index([exam, part, status])
  @@index([createdAt, id])
  @@map("lingo_items")
}

/// One question of an item. `answer` is never sent before the learner submits it
model LingoQuestion {
  id            String    @id @default(uuid(7)) @db.Uuid
  itemId        String    @map("item_id") @db.Uuid
  item          LingoItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  order         Int       @default(0)
  /// QuestionType of the spec (SINGLE_CHOICE…)
  type          String    @db.VarChar(32)
  /// `{ text?, options: string[] }` for SINGLE_CHOICE
  prompt        Json
  /// `{ choice: number }` for SINGLE_CHOICE
  answer        Json
  explanationVi String    @default("") @map("explanation_vi")
  translationVi String?   @map("translation_vi")
  skillTags     String[]  @map("skill_tags")

  answers LingoAnswer[]

  @@index([itemId, order])
  @@map("lingo_questions")
}

/// A practice session or test taken by a user
model LingoAttempt {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam         String           @db.VarChar(32)
  mode         LingoAttemptMode
  parts        String[]
  timeLimitSec Int?             @map("time_limit_sec")
  total        Int
  correct      Int?
  /// Per section `{ L: { correct, total, scaled? } }`, set on submit
  scores       Json?
  testId       String?          @map("test_id") @db.Uuid
  test         LingoTest?       @relation(fields: [testId], references: [id], onDelete: SetNull)
  startedAt    DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  submittedAt  DateTime?        @map("submitted_at") @db.Timestamptz(3)

  answers LingoAnswer[]

  @@index([userId, startedAt])
  @@index([testId])
  @@map("lingo_attempts")
}

/// A learner's answer to one question of an attempt (row created when the attempt starts)
model LingoAnswer {
  id         String        @id @default(uuid(7)) @db.Uuid
  attemptId  String        @map("attempt_id") @db.Uuid
  attempt    LingoAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String        @map("question_id") @db.Uuid
  question   LingoQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  /// `{ choice: number }` for SINGLE_CHOICE; null = not answered
  response   Json?
  /// Set on submit
  correct    Boolean?
  timeMs     Int?          @map("time_ms")
  flagged    Boolean       @default(false)
  answeredAt DateTime?     @map("answered_at") @db.Timestamptz(3)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("lingo_answers")
}

/// A learner's goal for one exam
model LingoGoal {
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam           String    @db.VarChar(32)
  /// In the exam's scale (TOEIC 10–990)
  targetScore    Int?      @map("target_score")
  examDate       DateTime? @map("exam_date") @db.Date
  newCardsPerDay Int       @default(20) @map("new_cards_per_day")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([userId, exam])
  @@map("lingo_goals")
}

/// A flashcard deck: system deck (ownerId null) or a learner's own
model LingoDeck {
  id          String   @id @default(uuid(7)) @db.Uuid
  exam        String?  @db.VarChar(32)
  ownerId     String?  @map("owner_id") @db.Uuid
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// BCP 47 of the terms (en, zh…)
  language    String   @db.VarChar(8)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cards LingoCard[]

  @@index([exam])
  @@index([ownerId])
  @@map("lingo_decks")
}

model LingoCard {
  id         String    @id @default(uuid(7)) @db.Uuid
  deckId     String    @map("deck_id") @db.Uuid
  deck       LingoDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  term       String    @db.VarChar(100)
  pos        String?   @db.VarChar(20)
  /// IPA (en) or pinyin (zh)
  reading    String?   @db.VarChar(100)
  meaningVi  String    @map("meaning_vi") @db.VarChar(500)
  example    String?   @db.VarChar(500)
  exampleVi  String?   @map("example_vi") @db.VarChar(500)
  topic      String?   @db.VarChar(50)
  /// "Từ mở rộng": word family and phrases, `{ term?, pos?, meaningVi }[]` (no term = usage note)
  extensions Json?
  audioKey   String?   @map("audio_key") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  states LingoCardState[]

  @@unique([deckId, term])
  @@map("lingo_cards")
}

/// FSRS memory state of one card for one learner (ts-fsrs `Card`); created on the first review
model LingoCardState {
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId        String    @map("card_id") @db.Uuid
  card          LingoCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  due           DateTime  @db.Timestamptz(3)
  stability     Float
  difficulty    Float
  elapsedDays   Int       @map("elapsed_days")
  scheduledDays Int       @map("scheduled_days")
  learningSteps Int       @map("learning_steps")
  reps          Int
  lapses        Int
  /// ts-fsrs State: 0 New, 1 Learning, 2 Review, 3 Relearning
  state         Int
  lastReview    DateTime? @map("last_review") @db.Timestamptz(3)
  /// First review: counts against the learner's new cards per day
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, cardId])
  @@index([userId, due])
  @@map("lingo_card_states")
}

/// Who wrote a message of an AI tutor chat
enum LingoChatRole {
  USER
  ASSISTANT
}

/// A learner's conversation with the AI tutor
model LingoChat {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// First question, shortened
  title     String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Bumped on every message: newest conversation first
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  messages LingoChatMessage[]

  @@index([userId, updatedAt])
  @@map("lingo_chats")
}

model LingoChatMessage {
  id        String        @id @default(uuid(7)) @db.Uuid
  chatId    String        @map("chat_id") @db.Uuid
  chat      LingoChat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      LingoChatRole
  content   String
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([chatId, createdAt])
  @@map("lingo_chat_messages")
}

/// A test (đề): published items in exam order. Learners take all of it or chosen parts
model LingoTest {
  id          String             @id @default(uuid(7)) @db.Uuid
  exam        String             @db.VarChar(32)
  title       String             @db.VarChar(150)
  kind        LingoTestKind
  description String?            @db.VarChar(1000)
  /// PUBLISHED needs every item PUBLISHED
  status      LingoContentStatus @default(DRAFT)
  createdById String?            @map("created_by_id") @db.Uuid
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// The AI run that generated it
  batchId     String?            @map("batch_id") @db.Uuid
  batch       LingoBatch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  items    LingoTestItem[]
  attempts LingoAttempt[]

  @@index([exam, status, createdAt])
  @@index([createdAt, id])
  @@map("lingo_tests")
}

model LingoTestItem {
  testId String    @map("test_id") @db.Uuid
  test   LingoTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  itemId String    @map("item_id") @db.Uuid
  item   LingoItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Position in the test (parts in exam order)
  order  Int

  @@id([testId, itemId])
  @@index([itemId])
  @@map("lingo_test_items")
}

/// A module of a course (grammar, listening…): its lessons in study order
model LingoLessonModule {
  id          String   @id @default(uuid(7)) @db.Uuid
  exam        String   @db.VarChar(32)
  /// URL key inside the exam, lowercase kebab-case
  slug        String   @db.VarChar(80)
  title       String   @db.VarChar(120)
  description String   @default("") @db.VarChar(500)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lessons LingoLesson[]

  @@unique([exam, slug])
  @@index([exam, order])
  @@map("lingo_lesson_modules")
}

/// A theory lesson (Markdown) with a checklist and an optional practice of one skill. Progress is
/// not stored: it comes from the learner's answers to questions of `practiceSkillTag`
model LingoLesson {
  id               String             @id @default(uuid(7)) @db.Uuid
  moduleId         String             @map("module_id") @db.Uuid
  module           LingoLessonModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  /// URL key, lowercase kebab-case; the 12-week plan links lessons by it
  slug             String             @unique @db.VarChar(80)
  title            String             @db.VarChar(160)
  summary          String             @default("") @db.VarChar(500)
  /// Markdown (GFM)
  content          String             @default("")
  /// Checklist shown under the lesson ("Nhớ khi làm bài")
  keyPoints        String[]           @map("key_points")
  /// Parts the lesson is about (P1…P7)
  parts            String[]
  minutes          Int                @default(10)
  /// Practice draws published questions of this part…
  practicePart     String?            @map("practice_part") @db.VarChar(16)
  /// …tagged with this skill, when set
  practiceSkillTag String?            @map("practice_skill_tag") @db.VarChar(64)
  order            Int                @default(0)
  status           LingoContentStatus @default(DRAFT)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([moduleId, order])
  @@map("lingo_lessons")
}

// ─── Planner: daily / monthly schedule with a kanban board ─────────────────────────────────────

/// Kanban column of a planner task
enum PlannerStatus {
  TODO
  DOING
  DONE
}

enum PlannerPriority {
  LOW
  MEDIUM
  HIGH
}

/// One job on a user's planner: shown on the board (by `status`) and, when `date` is set, on the
/// calendar (all day, or at `startMinute` for `durationMinutes` when it has a time).
model PlannerTask {
  id              String          @id @default(uuid(7)) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String          @db.VarChar(200)
  note            String?         @db.VarChar(2000)
  status          PlannerStatus   @default(TODO)
  priority        PlannerPriority @default(MEDIUM)
  /// Calendar day (Vietnam time); null = backlog, not scheduled yet
  date            DateTime?       @db.Date
  /// Minutes after midnight (0–1439); null = all day
  startMinute     Int?            @map("start_minute")
  durationMinutes Int             @default(60) @map("duration_minutes")
  /// Palette key of the web planner (`sky`, `rose` …)
  color           String          @default("sky") @db.VarChar(16)
  /// Order inside a board column, ascending (fractional: a move rewrites one row)
  position        Float           @default(0)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, date])
  @@index([userId, status, position])
  @@map("planner_tasks")
}

// ─── Studio: learn programming (docs/product/studio.md) ────────────────────────────────────────

/// Menu group of a track
enum StudioCategory {
  LANGUAGE
  FRAMEWORK
  PATTERN
  FUNDAMENTAL
  TOOL
}

/// Only PUBLISHED reaches learners
enum StudioStatus {
  DRAFT
  PUBLISHED
}

/// One subject to learn ("TypeScript", "NestJS", "Observer"): an ordered list of lessons
model StudioTrack {
  id        String         @id @default(uuid(7)) @db.Uuid
  /// URL key, lowercase kebab-case
  slug      String         @unique @db.VarChar(80)
  category  StudioCategory
  title     String         @db.VarChar(120)
  summary   String         @default("") @db.VarChar(500)
  /// Order inside its category, ascending
  order     Int            @default(0)
  status    StudioStatus   @default(DRAFT)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  lessons StudioLesson[]
  steps   StudioRoadmapStep[]

  @@index([category, status, order])
  @@map("studio_tracks")
}

/// One lesson of a track: Markdown with code blocks, then a short quiz
model StudioLesson {
  id        String       @id @default(uuid(7)) @db.Uuid
  trackId   String       @map("track_id") @db.Uuid
  track     StudioTrack  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  /// URL key inside the track, lowercase kebab-case
  slug      String       @db.VarChar(80)
  title     String       @db.VarChar(160)
  summary   String       @default("") @db.VarChar(500)
  /// Markdown (GFM)
  content   String       @default("")
  minutes   Int          @default(10)
  order     Int          @default(0)
  status    StudioStatus @default(DRAFT)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  questions StudioQuizQuestion[]
  progress  StudioProgress[]

  @@unique([trackId, slug])
  @@index([trackId, order])
  @@map("studio_lessons")
}

/// A single-choice question at the end of a lesson. `answer` and `explanation` are sent to a
/// learner only after the quiz is submitted
model StudioQuizQuestion {
  id          String       @id @default(uuid(7)) @db.Uuid
  lessonId    String       @map("lesson_id") @db.Uuid
  lesson      StudioLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order       Int          @default(0)
  prompt      String       @db.VarChar(1000)
  choices     String[]
  /// Index into `choices`
  answer      Int
  explanation String       @default("") @db.VarChar(2000)

  @@index([lessonId, order])
  @@map("studio_quiz_questions")
}

/// A learning path ("Frontend", "Backend"): ordered steps, most of them pointing at a track
model StudioRoadmap {
  id        String       @id @default(uuid(7)) @db.Uuid
  slug      String       @unique @db.VarChar(80)
  title     String       @db.VarChar(120)
  summary   String       @default("") @db.VarChar(500)
  order     Int          @default(0)
  status    StudioStatus @default(DRAFT)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  steps StudioRoadmapStep[]

  @@index([status, order])
  @@map("studio_roadmaps")
}

model StudioRoadmapStep {
  id          String        @id @default(uuid(7)) @db.Uuid
  roadmapId   String        @map("roadmap_id") @db.Uuid
  roadmap     StudioRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  order       Int           @default(0)
  title       String        @db.VarChar(160)
  description String        @default("") @db.VarChar(1000)
  /// The track that teaches this step; null: a step without lessons yet
  trackId     String?       @map("track_id") @db.Uuid
  track       StudioTrack?  @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@index([roadmapId, order])
  @@map("studio_roadmap_steps")
}

/// A learner's state on one lesson. Track and roadmap progress are counted from these rows
model StudioProgress {
  userId      String       @map("user_id") @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String       @map("lesson_id") @db.Uuid
  lesson      StudioLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// Set by "done" or by a passed quiz; null: opened or quizzed, not finished
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  /// Best quiz result so far
  quizScore   Int?         @map("quiz_score")
  quizTotal   Int?         @map("quiz_total")
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([userId, lessonId])
  @@index([userId, updatedAt])
  @@map("studio_progress")
}
