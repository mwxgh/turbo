generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Plain interfaces + enums for the web, committed in packages/types
generator types {
  provider = "tsx prisma/generators/types.ts"
  output   = "../../types/src/generated"
}

datasource db {
  provider = "postgresql"
}

model Hello {
  id        String   @id @default(uuid(7)) @db.Uuid
  message   String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Default list order: `createdAt desc, id desc`
  @@index([createdAt, id])
  @@map("hellos")
}

/// What a user may do: ADMIN manages the app, USER is everyone else
enum Role {
  USER
  ADMIN
}

/// Someone who signs in: with a password and / or external providers (`UserIdentity`);
/// `passwordHash` stays null for accounts that only use a provider.
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Lowercase. Sign in with email or username
  email        String?   @unique @db.VarChar(255)
  /// Lowercase
  username     String?   @unique @db.VarChar(50)
  name         String?   @db.VarChar(100)
  /// @private argon2id hash, PHC format (`@repo/auth`); null when the account has no password
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  role         Role      @default(USER)
  /// Set to block sign-in and refresh; existing access tokens expire on their own
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions   Session[]
  identities UserIdentity[]

  @@map("users")
}

/// Sign-in providers (OAuth 2.0 authorization code + PKCE, handled by the api).
enum OAuthProvider {
  GOOGLE
  FACEBOOK
  GITHUB
}

/// @private A provider account that signs in as a user. `subject` is the provider's stable user id
/// (never the email: emails change and can be reassigned).
model UserIdentity {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  OAuthProvider
  subject   String        @db.VarChar(255)
  /// Email the provider reported at the last sign-in (informational; lowercase)
  email     String?       @db.VarChar(255)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

/// @private One signed-in device. The refresh token is `<id>.<secret>`; only hashes are stored and the
/// secret rotates on every refresh (the previous one stays valid for a short grace period).
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 (hex) of the current refresh secret
  tokenHash     String    @map("token_hash") @db.Char(64)
  /// sha256 of the secret before the last rotation (concurrent refreshes from tabs)
  prevTokenHash String?   @map("prev_token_hash") @db.Char(64)
  rotatedAt     DateTime? @map("rotated_at") @db.Timestamptz(3)
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  ip            String?   @db.VarChar(45)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}
