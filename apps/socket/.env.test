# Browser e2e (Playwright) – loaded by `start:e2e` INSTEAD of .env (see apps/api/.env.test).
# Overrides: .env.test.local (untracked). Committed: no real secrets.
NODE_ENV=test
APP_ENV=dev
HOST=127.0.0.1
PORT=3002
LOG_FORMAT=pretty
LOG_LEVEL=warn
CORS_ORIGINS=http://localhost:3000

# Same Redis database as apps/api/.env.test
REDIS_URL=redis://127.0.0.1:6379/14

# Same value as apps/api/.env.test
JWT_SECRET=e2e-jwt-secret-at-least-32-characters-long
