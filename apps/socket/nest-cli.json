{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "builder": {
      "type": "swc",
      "options": {
        "swcrcPath": "../../packages/typescript-config/nest.swcrc"
      }
    },
    "deleteOutDir": true
  },
  "generateOptions": {
    "spec": false
  },
  "sourceRoot": "src"
}
