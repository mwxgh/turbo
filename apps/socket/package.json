{
  "name": "socket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "catalog:nestjs",
    "@nestjs/core": "catalog:nestjs",
    "@nestjs/platform-express": "catalog:nestjs",
    "@nestjs/platform-socket.io": "catalog:nestjs",
    "@nestjs/swagger": "catalog:nestjs",
    "@nestjs/websockets": "catalog:nestjs",
    "@repo/decorators": "workspace:*",
    "@repo/socket-events": "workspace:*",
    "@repo/utils": "workspace:*",
    "class-transformer": "catalog:nestjs",
    "class-validator": "catalog:nestjs",
    "reflect-metadata": "catalog:nestjs",
    "rxjs": "catalog:nestjs",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:nestjs",
    "@nestjs/schematics": "catalog:nestjs",
    "@nestjs/testing": "catalog:nestjs",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "catalog:tooling",
    "@vitest/coverage-v8": "catalog:tooling",
    "eslint": "catalog:tooling",
    "socket.io-client": "4.8.4",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling"
  }
}
