# Browser e2e (Playwright: `pnpm --filter e2e test:e2e`) – loaded by `start:e2e` INSTEAD of .env,
# so the tests never reach the services your .env points at. Local Docker services only
# (`pnpm infra:up`); put machine-specific values (e.g. another Postgres password) in
# .env.test.local (untracked), which overrides this file. No real secrets here: it is committed.
NODE_ENV=test
APP_ENV=dev
HOST=127.0.0.1
PORT=3001
LOG_FORMAT=pretty
LOG_LEVEL=warn
CORS_ORIGINS=http://localhost:3000

# Own database next to the dev one (created and migrated by apps/e2e/global-setup.ts)
DATABASE_URL=postgresql://app:change-me@127.0.0.1:5432/app_e2e?schema=public
# Own Redis database (dev uses 0, vitest e2e 15)
REDIS_URL=redis://127.0.0.1:6379/14

# The upload test stubs the presign call; nothing reaches this storage
STORAGE_CORE_S3_SERVERS='[{"NAME":"default","CONFIG":{"PUBLIC_ENDPOINT":"http://127.0.0.1:9000","ENDPOINT":"http://127.0.0.1:9000","KEY":"e2e","SECRET":"e2e-secret","REGION":"us-east-1"}}]'
STORAGE_BUCKET=e2e

# Same value as apps/socket/.env.test
JWT_SECRET=e2e-jwt-secret-at-least-32-characters-long
# auth.setup.ts registers the test user
AUTH_REGISTRATION=open
# Every browser and SSR request comes from localhost; several tests sign in within a minute
RATE_LIMIT=100000
AUTH_RATE_LIMIT=100000
