{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --type-check --env-file .env",
    "start:debug": "nest start --debug --watch --type-check --env-file .env",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@aws-sdk/s3-presigned-post": "3.1153.0",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@repo/db": "workspace:*",
    "@repo/nest-common": "workspace:*",
    "@repo/redis": "workspace:*",
    "@repo/utils": "workspace:*",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "supertest": "7.3.1",
    "type-fest": "5.10.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
