NODE_ENV=development
# Deployment environment: dev | stg | prod (docs/process/environments.md)
APP_ENV=dev
HOST=0.0.0.0
# Logs: json (servers) | pretty (local); level fatal|error|warn|info|debug|trace|silent
LOG_FORMAT=pretty
LOG_LEVEL=info
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# PostgreSQL (see deploy/.env)
DATABASE_URL=postgresql://app:change-me@127.0.0.1:5432/app?schema=public

# Redis (see deploy/.env); keys are prefixed with APP_ENV
REDIS_URL=redis://127.0.0.1:6379

# File storage: S3 / MinIO, btp format (required) – never commit real values.
# The bucket must allow browser POST uploads from the web origin (CORS).
STORAGE_CORE_S3_SERVERS='[{"NAME":"default","CONFIG":{"PUBLIC_ENDPOINT":"https://minio.example.com","ENDPOINT":"https://minio.example.com","KEY":"<access-key>","SECRET":"<secret-key>","REGION":"us-east-1"}}]'
STORAGE_BUCKET=<bucket>

# Auth: HS256 secret for access tokens, same value in apps/socket/.env (openssl rand -base64 48)
JWT_SECRET=<at-least-32-characters>
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# open: anyone can POST /api/auth/register; closed (default): accounts from admins / seed
AUTH_REGISTRATION=open
# Parent domain when web and api are on different subdomains, e.g. example.com
# COOKIE_DOMAIN=

# Rate limit per client IP (all routes except /api/health), shared through Redis
# RATE_LIMIT=100
# RATE_LIMIT_TTL_SECONDS=60
# Max JSON / form body
# BODY_LIMIT=100kb
# Reverse proxies in front of the API (load balancer, ingress): 1 = trust one hop
# TRUST_PROXY=0
