import { Test } from '@nestjs/testing'

import { beforeEach, describe, expect, it, vi } from 'vitest'

import { PrismaService } from '@repo/db/nest'

import { {{ pascalCase name }}Service } from './{{ kebabCase name }}.service'

const item = {
  id: '11111111-1111-4111-8111-111111111111',
  name: 'A',
  createdAt: new Date('2026-01-01T00:00:00Z'),
  updatedAt: new Date('2026-01-01T00:00:00Z'),
}

describe('{{ pascalCase name }}Service', () => {
  let service: {{ pascalCase name }}Service
  const prisma = {
    {{ camelCase model }}: {
      findMany: vi.fn(),
      count: vi.fn(),
      findUniqueOrThrow: vi.fn(),
      create: vi.fn(),
      update: vi.fn(),
      delete: vi.fn(),
    },
  }

  beforeEach(async () => {
    vi.clearAllMocks()
    const moduleRef = await Test.createTestingModule({
      providers: [{{ pascalCase name }}Service, { provide: PrismaService, useValue: prisma }],
    }).compile()
    service = moduleRef.get({{ pascalCase name }}Service)
  })

  it('pages newest first and returns the total', async () => {
    prisma.{{ camelCase model }}.findMany.mockResolvedValue([item])
    prisma.{{ camelCase model }}.count.mockResolvedValue(21)

    await expect(service.findAll({ page: 3, pageSize: 10 })).resolves.toEqual({
      items: [item],
      total: 21,
      page: 3,
      pageSize: 10,
      totalPages: 3,
    })
    expect(prisma.{{ camelCase model }}.findMany).toHaveBeenCalledWith({
      where: {},
      orderBy: [{ createdAt: 'desc' }, { id: 'desc' }],
      skip: 20,
      take: 10,
    })
  })

  it('rejects filters the spec does not allow (→ 400)', async () => {
    await expect(
      service.findAll({ page: 1, pageSize: 20, filter: { secret: 1 } }),
    ).rejects.toThrow('Unknown filter "secret"')
    expect(prisma.{{ camelCase model }}.findMany).not.toHaveBeenCalled()
  })

  it('finds, creates, updates and removes by id', async () => {
    prisma.{{ camelCase model }}.findUniqueOrThrow.mockResolvedValue(item)
    prisma.{{ camelCase model }}.create.mockResolvedValue(item)
    prisma.{{ camelCase model }}.update.mockResolvedValue({ ...item, name: 'B' })
    prisma.{{ camelCase model }}.delete.mockResolvedValue(item)

    await expect(service.findOne(item.id)).resolves.toBe(item)
    await expect(service.create({ name: 'A' })).resolves.toBe(item)
    await expect(service.update(item.id, { name: 'B' })).resolves.toMatchObject({
      name: 'B',
    })
    await expect(service.remove(item.id)).resolves.toBeUndefined()

    const byId = { where: { id: item.id } }
    expect(prisma.{{ camelCase model }}.findUniqueOrThrow).toHaveBeenCalledWith(byId)
    expect(prisma.{{ camelCase model }}.create).toHaveBeenCalledWith({ data: { name: 'A' } })
    expect(prisma.{{ camelCase model }}.update).toHaveBeenCalledWith({
      ...byId,
      data: { name: 'B' },
    })
    expect(prisma.{{ camelCase model }}.delete).toHaveBeenCalledWith(byId)
  })
})
