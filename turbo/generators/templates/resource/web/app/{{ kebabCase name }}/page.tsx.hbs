import { HydrationBoundary, dehydrate } from '@tanstack/react-query'

import {
  loadListTableState,
  toListQuery,
} from '@repo/ui/components/data-table/server'

import { {{ camelCase name }}ListQueryOptions } from '../../lib/queries/{{ kebabCase name }}'
import { getQueryClient } from '../../lib/query-client'
import { {{ pascalCase name }}View } from './{{ kebabCase name }}-view'

export const dynamic = 'force-dynamic'

export default async function {{ pascalCase name }}Page({
  searchParams,
}: PageProps<'/{{ kebabCase name }}'>) {
  // Prefetch the page the URL asks for; the table reuses the same cache entry
  const query = toListQuery(await loadListTableState(searchParams))
  const queryClient = getQueryClient()
  await queryClient.prefetchQuery({{ camelCase name }}ListQueryOptions(query))

  return (
    <main className="mx-auto flex max-w-3xl flex-col gap-6 px-4 py-12">
      <HydrationBoundary state={dehydrate(queryClient)}>
        <{{ pascalCase name }}View />
      </HydrationBoundary>
    </main>
  )
}
