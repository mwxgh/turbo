'use client'

import { useMemo, useState } from 'react'

import { Pencil, Trash2 } from 'lucide-react'

import type { {{ pascalCase model }} } from '@repo/types'
import {
  DataTable,
  actionsColumn,
  dataTableColumns,
  useListTable,
} from '@repo/ui/components/data-table'
import { formatDateTime } from '@repo/utils'

import { {{ camelCase name }}ListQueryOptions } from '../../lib/queries/{{ kebabCase name }}'
import { {{ pascalCase model }}Form } from './{{ kebabCase model }}-form'
import {
  use{{ pascalCase model }}Actions,
  useDelete{{ pascalCase model }},
} from './use-{{ kebabCase model }}-mutations'

const col = dataTableColumns<{{ pascalCase model }}>()

/** Server-side list: sort, search, date filter and pages go through the API (URL state). */
export function {{ pascalCase name }}Table() {
  const [editingId, setEditingId] = useState<string | null>(null)
  const actions = use{{ pascalCase model }}Actions()
  const { mutate: remove } = useDelete{{ pascalCase model }}()

  const columns = useMemo(
    () =>
      col.columns([
        col.accessor('name', {
          header: 'Name',
          enableSorting: true,
          cell: ({ row }) =>
            row.original.id === editingId ? (
              <{{ pascalCase model }}Form
                action={(input) => actions.update(row.original.id, input)}
                defaultName={row.original.name}
                submitLabel="Save"
                inputLabel="Edit name"
                autoFocus
                onSuccess={() => setEditingId(null)}
                onCancel={() => setEditingId(null)}
              />
            ) : (
              row.original.name
            ),
        }),
        col.accessor('createdAt', {
          header: 'Created',
          enableSorting: true,
          meta: { filterVariant: 'dateRange' },
          cell: ({ getValue }) => (
            <time dateTime={getValue()} className="text-muted-foreground">
              {formatDateTime(getValue())}
            </time>
          ),
        }),
        actionsColumn<{{ pascalCase model }}>((item) =>
          item.id === editingId
            ? []
            : [
                {
                  label: 'Edit',
                  icon: <Pencil />,
                  onClick: () => setEditingId(item.id),
                },
                {
                  label: 'Delete',
                  icon: <Trash2 />,
                  variant: 'destructive',
                  onClick: () => remove(item.id),
                },
              ],
        ),
      ]),
    [editingId, actions, remove],
  )

  const list = useListTable({
    columns,
    listQuery: {{ camelCase name }}ListQueryOptions,
    getRowId: (item) => item.id,
  })

  return (
    <DataTable
      list={list}
      searchPlaceholder="Search {{ words name }}…"
      emptyMessage="No {{ words name }} yet."
    />
  )
}
