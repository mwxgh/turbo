{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "APP_ENV",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    // Type-aware lint resolves workspace packages through their built .d.ts
    "lint": {
      "dependsOn": ["^build"],
      "env": ["ESLINT_TYPE_CHECK"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    // Unit tests (*.spec.ts): no external services, cacheable
    "test": {
      "dependsOn": ["^build"]
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    // E2E: real Postgres / running apps / browsers – results depend on external
    // state, so never cached
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_*", "E2E_*", "CI"]
    }
  },
  "ui": "tui"
}
