{
  "name": "turbo-base",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "check-types": "turbo run check-types",
    "dev:api": "turbo run dev --filter=api",
    "dev:socket": "turbo run dev --filter=socket",
    "dev:web": "turbo run dev --filter=web",
    "start:api": "pnpm --filter api start",
    "start:socket": "pnpm --filter socket start",
    "start:web": "pnpm --filter web start",
    "infra": "docker compose -f deploy/docker-compose.yml --env-file deploy/.env",
    "infra:up": "pnpm infra up -d --wait",
    "infra:down": "pnpm infra down",
    "infra:ps": "pnpm infra ps",
    "infra:logs": "pnpm infra logs -f --tail=100",
    "stack:up": "pnpm infra --profile app up -d --build --wait",
    "stack:down": "pnpm infra --profile app rm -sf migrate api socket web",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:deploy": "pnpm --filter @repo/db db:deploy",
    "db:check": "pnpm --filter @repo/db db:check",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "test": "turbo run test",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "renovate:check": "pnpm dlx --package=renovate@44.172.0 renovate-config-validator --strict renovate.json5",
    "deps:outdated": "pnpm outdated -r",
    "deps:update": "pnpm update -r -i --latest",
    "docs:convert": "sh scripts/docs-convert.sh",
    "test:cov": "turbo run test:cov",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.6",
    "prettier-plugin-classnames": "0.10.4",
    "prettier-plugin-merge": "0.10.1",
    "prettier-plugin-sort-json": "4.2.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.9",
    "typescript": "catalog:tooling"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
